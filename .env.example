# PostgreSQL (Neon or Supabase pooled URL for Vercel runtime)
DATABASE_URL="postgresql://user:password@localhost:5432/langhomestay"
# Direct URL used by Prisma migrations
DIRECT_URL="postgresql://user:password@localhost:5432/langhomestay"
# Keep false until database is migrated/seeded, payOS is connected, and policies are confirmed
BOOKINGS_ENABLED="false"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
ADMIN_EMAIL=""
# salt:scrypt-hex (64-byte output); see README for safe generation
ADMIN_PASSWORD_HASH=""
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
# Owner-confirmed 24h times (HH:mm); blank disables online overnight booking
OVERNIGHT_CHECK_IN=""
OVERNIGHT_CHECK_OUT=""
# Owner-confirmed cancellation/refund/check-in terms shown before accepting a booking
BOOKING_TERMS=""

