APP_URL=https://example.com
APP_KEY=CHANGE_TO_A_LONG_RANDOM_STRING
APP_TIMEZONE=Asia/Ho_Chi_Minh
DEPLOY_HOOK_KEY=CHANGE_TO_ANOTHER_LONG_RANDOM_STRING

BOOKINGS_ENABLED=false
OVERNIGHT_CHECK_IN=
OVERNIGHT_CHECK_OUT=
BOOKING_TERMS=""
MAIL_FROM=no-reply@example.com
MAIL_REPLY_TO=hello@example.com

ADMIN_EMAIL=admin@example.com
# Tao bang lenh: php tools/password.php
ADMIN_PASSWORD_HASH=$2y$12$gVklb3m.6XTt/xOP6.kFHuBJR3qO8uizBb7N6KAgEuMEQ3yVpG/Cy

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=directadmin_database
DB_USERNAME=directadmin_user
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Official Mo Home social destinations (HTTPS)
CONTACT_MESSENGER_URL=
CONTACT_FACEBOOK_URL=

# Optional override; defaults to the property pin confirmed by Mo Home's owner.
# OpenStreetMap + Leaflet needs no API key.
HOME_MAP_LATITUDE=
HOME_MAP_LONGITUDE=

# Arrival details shown to guests after confirmed payment. Links must use HTTPS.
CHECKIN_GUIDE_URL=
HOUSE_RULES_URL=
WIFI_NAME=
WIFI_PASSWORD=

# Keep disabled until the application is approved and a real-lock test passes.
TTLOCK_ENABLED=false
# Must match the region of your TTLock application/account.
TTLOCK_BASE_URL=https://api.sciener.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
# Lowercase MD5 of the TTLock mobile app password; treat as a secret.
TTLOCK_PASSWORD_MD5=
TTLOCK_LOCK_ID=

# GENERATED: offline algorithm, activation rounds up to next whole hour.
# CUSTOM: exact check-in time; requires a working gateway for remote writing.
TTLOCK_CODE_MODE=GENERATED

# Read-only revenue integration (same secret in TN PHP server)
REVENUE_INTEGRATION_KEY=

# Separate HMAC key, >=32 random characters. Empty disables counter ingestion.
PEOPLE_COUNTER_KEY=

# Read-only Imou API check. Keep the secret private; select the account's actual region.
IMOU_APP_ID=
IMOU_APP_SECRET=
IMOU_API_HOST=
