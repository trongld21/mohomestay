# Local Docker configuration. Generate .env.docker with npm run docker:setup.
APP_PORT=3200
NEXT_PUBLIC_SITE_URL=http://localhost:3200
# Generated as hexadecimal: if changed manually, use URL-safe letters/numbers.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
NEXTAUTH_SECRET=GENERATE_NEXTAUTH_SECRET

# Enable only after payOS and booking policies are configured.
BOOKINGS_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
OVERNIGHT_CHECK_IN=
OVERNIGHT_CHECK_OUT=
BOOKING_TERMS=
