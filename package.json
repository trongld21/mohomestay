{
  "name": "langhomestay",
  "version": "1.0.0",
  "description": "Homestay booking website with Next.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node scripts/prisma.cjs db push",
    "db:generate": "node scripts/prisma.cjs generate",
    "db:migrate": "node scripts/prisma.cjs migrate dev",
    "postinstall": "node scripts/prisma.cjs generate",
    "db:deploy": "node scripts/prisma.cjs migrate deploy",
    "db:seed": "node prisma/seed.cjs",
    "test": "tsc -p tsconfig.test.json && node --test tests/booking.test.cjs",
    "test:integration": "tsc -p tsconfig.test.json && node --test tests/integration.test.cjs",
    "admin:password": "python3 scripts/admin_password.py",
    "docker:setup": "node scripts/docker-setup.cjs",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f web",
    "docker:status": "docker compose --env-file .env.docker ps -a"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.0.0",
    "@prisma/client": "^5.0.0",
    "@next-auth/prisma-adapter": "^1.0.0",
    "next-auth": "^4.24.0",
    "axios": "^1.6.0",
    "react-qr-code": "^2.0.0",
    "react-calendar": "^4.2.0",
    "lucide-react": "^0.263.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "prisma": "^5.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
