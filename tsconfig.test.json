{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "jsx": "react",
    "target": "ES2020"
  },
  "include": [
    "lib/rooms.ts",
    "lib/booking.ts",
    "lib/payment.ts",
    "lib/db.ts",
    "app/api/bookings/route.ts",
    "app/api/bookings/lookup/route.ts",
    "app/api/availability/route.ts",
    "app/api/payments/webhook/route.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
